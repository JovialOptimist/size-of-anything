# Cesium Ion access token (optional). Get a free token at https://cesium.com/ion/
# When set, enables 3D terrain and optional global 3D buildings layer.
# VITE_CESIUM_ION_TOKEN=your_token_here

# Google Maps API key (optional). Get a key at https://console.developers.google.com/
# When set, enables Google Photorealistic 3D Tiles (like Google Earth with trees and textured buildings).
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
